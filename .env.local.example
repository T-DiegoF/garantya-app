# WalletConnect Project ID — get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_ID=your_wallet_connect_project_id

# GarantYa Factory contract address deployed on Avalanche Fuji
NEXT_PUBLIC_FACTORY_ADDRESS=0xYourFactoryAddressHere

# Block number when the factory was deployed (avoids scanning from genesis)
# Find it on https://testnet.snowtrace.io after deploying the factory
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=0
