# ─── WalletConnect ────────────────────────────────────────────────────────────
# WalletConnect Cloud Project ID. Required by RainbowKit to show the wallet
# connection modal (MetaMask, Rainbow, etc).
# Get one free at: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_ID=your_wallet_connect_project_id

# ─── Smart Contracts (Avalanche Fuji Testnet) ─────────────────────────────────
# Address of the GarantYaFactory contract deployed on Fuji.
# Obtained by running: npx hardhat run scripts/deploy.js --network fuji
NEXT_PUBLIC_FACTORY_ADDRESS=0xYourFactoryAddressHere

# Block number at which the factory was deployed.
# Prevents scanning from the genesis block when fetching events (very slow).
# Printed alongside the factory address when running the deploy script.
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=0

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Supabase project URL. Used to store off-chain metadata for each contract
# (property address, landlord and tenant names).
# Find it at: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public, no admin privileges).
# Used on the frontend to read/write data subject to RLS policies.
# Find it at: Supabase Dashboard → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Deploy (Hardhat only — never exposed to the browser) ─────────────────────
# Private key of the wallet that pays gas for the Fuji deployment.
# This wallet becomes the factory owner (can pause it, update fees, etc).
# NEVER commit this value. Make sure .env.local is in .gitignore.
DEPLOYER_PRIVATE_KEY=your_deployer_private_key

# Address of the wallet acting as the global arbitrator for the factory.
# The arbitrator resolves disputes between landlords and tenants.
# MUST be different from the deployer wallet (the contract enforces this).
# In production, use a Gnosis Safe multisig.
ARBITRATOR_ADDRESS=0xYourArbitratorAddressHere
